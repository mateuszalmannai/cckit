#!/usr/bin/env bash
#
# secret — keep secrets in the macOS login Keychain instead of shell dotfiles.
#
#   secret set <name>            store a value (hidden prompt; or piped: pbpaste | secret set <name>)
#   secret get <name>            print the value (for scripts: export X="$(secret get x)")
#   secret copy <name>           copy the value to the clipboard
#   secret check <name>...       exists? length and first 5 chars, never the value
#   secret list                  items stored by this tool
#   secret rm <name>             delete an item (asks first)
#   secret import <file> [--rewrite] [VAR[=name]...]
#                                move `export VAR=value` lines of a zsh/bash file into the Keychain;
#                                --rewrite replaces those lines with Keychain lookups
#
# SECRET_KEYCHAIN=<path> uses that keychain file instead of the default (login) Keychain.
#
# Values reach `security` on stdin, never on the command line (not visible in `ps`, not in history),
# and are not cut at 128 chars like the interactive `security add-generic-password -w` prompt.

set -euo pipefail

TAG="managed by secret"   # Keychain "kind" field, used by `secret list`

if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  B=$'\e[1m'; DIM=$'\e[2m'; R=$'\e[0m'; RED=$'\e[31m'; GRN=$'\e[32m'; YLW=$'\e[33m'
else
  B=''; DIM=''; R=''; RED=''; GRN=''; YLW=''
fi
ok()   { printf '%s✓%s %s\n' "$GRN" "$R" "$*" >&2; }
warn() { printf '%s•%s %s\n' "$YLW" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$RED" "$R" "$*" >&2; exit 1; }

usage() { sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

[[ "$(uname)" == Darwin ]] || die "macOS only (uses the login Keychain via 'security')"

# optional keychain file as the last argument of every `security` call; safe with bash 3.2's set -u
KC=()
[[ -z "${SECRET_KEYCHAIN:-}" ]] || KC=("$SECRET_KEYCHAIN")

need_name() { [[ -n "${1:-}" ]] || die "missing <name>"; }

exists() { security find-generic-password -s "$1" ${KC[@]+"${KC[@]}"} >/dev/null 2>&1; }

# `-w` prints the value as bare hex when it holds a backslash or a non-ASCII byte, which cannot be
# told apart from a value that is hex itself; `-g` marks that form with 0x, so read it from there.
read_value() {
  local out line v
  out=$(security find-generic-password -s "$1" -g ${KC[@]+"${KC[@]}"} 2>&1 >/dev/null) || return 1
  line=$(printf '%s\n' "$out" | grep -m1 '^password: ') || return 1
  case "$line" in
    'password: 0x'*) v=${line#password: 0x}; printf '%s' "${v%% *}" | xxd -r -p ;;
    'password: "'*)  v=${line#password: \"}; printf '%s' "${v%\"}" ;;
    *) return 1 ;;
  esac
}

# store <name> <value> — value goes over stdin to `security -i`, quoted for its parser
store() {
  local name="$1" value="$2" esc
  [[ "$value" != *$'\n'* ]] || die "$name: value contains a newline, not supported"
  [[ -n "$value" ]] || die "$name: empty value, nothing stored"
  esc=$(printf '%s' "$value" | sed 's/[\\"]/\\&/g')
  local kc=""; [[ -z "${SECRET_KEYCHAIN:-}" ]] || kc=" \"$SECRET_KEYCHAIN\""
  printf 'add-generic-password -U -a "%s" -s "%s" -D "%s" -w "%s"%s\n' "$USER" "$name" "$TAG" "$esc" "$kc" \
    | security -i >/dev/null
  [[ "$(read_value "$name")" == "$value" ]] || die "$name: read-back does not match what was stored"
}

describe() {  # describe <name> — length and prefix only
  local v; v=$(read_value "$1") || { printf '%s✗%s %s %s(not in Keychain)%s\n' "$RED" "$R" "$1" "$DIM" "$R"; return 1; }
  printf '%s✓%s %s %s(%d chars, starts %s…)%s\n' "$GRN" "$R" "$1" "$DIM" "${#v}" "${v:0:5}" "$R"
}

cmd_set() {
  need_name "${1:-}"; local name="$1" value
  if [[ -t 0 ]]; then
    exists "$name" && warn "$name exists — it will be replaced"
    IFS= read -rs -p "Value for $name (hidden): " value; echo >&2
  else
    IFS= read -r value || true   # piped: first line
  fi
  store "$name" "$value"
  ok "stored $name (${#value} chars)"
}

cmd_get()  {  # value plus newline, as `security -w` prints it
  need_name "${1:-}"; local v; v=$(read_value "$1") || die "$1 not in Keychain"; printf '%s\n' "$v"
}

cmd_copy() {
  need_name "${1:-}"; local v; v=$(read_value "$1") || die "$1 not in Keychain"
  printf '%s' "$v" | pbcopy; ok "copied $1 to the clipboard"
}

cmd_check() {
  [[ $# -gt 0 ]] || die "missing <name>"; local rc=0 n
  for n in "$@"; do describe "$n" || rc=1; done; return $rc
}

cmd_list() {
  # dump-keychain prints attributes only (no -d), so no values and no prompts
  security dump-keychain ${KC[@]+"${KC[@]}"} 2>/dev/null | awk -v tag="$TAG" '
    /^keychain:/ { if (svc != "" && desc == tag) print svc; svc = ""; desc = "" }
    /"svce"<blob>=/ { s = $0; sub(/.*"svce"<blob>="/, "", s); sub(/"$/, "", s); svc = s }
    /"desc"<blob>=/ { d = $0; sub(/.*"desc"<blob>="/, "", d); sub(/"$/, "", d); desc = d }
    END { if (svc != "" && desc == tag) print svc }' | sort -u
}

cmd_rm() {
  need_name "${1:-}"; exists "$1" || die "$1 not in Keychain"
  local a; read -r -p "Delete $1 from the Keychain? [y/N] " a
  [[ "$a" == [yY]* ]] || { warn "kept $1"; return; }
  security delete-generic-password -s "$1" ${KC[@]+"${KC[@]}"} >/dev/null 2>&1; ok "deleted $1"
}

# true if `security -w` would print this value as hex: a backslash or any byte outside printable ASCII
# shellcheck disable=SC1003  # \\ is grep's escaped backslash, not a quote escape
hex_on_w() { printf '%s' "$1" | LC_ALL=C grep -q '[^ -~]\|\\'; }

# SOME_API_TOKEN -> some-api-token
default_name() { printf '%s' "$1" | tr 'A-Z_' 'a-z-'; }

looks_secret() { [[ "$1" =~ (PASSWORD|PASSWD|PW|TOKEN|SECRET|KEY)($|_) ]]; }

# the $(...) is written into the dotfile literally, so the shell that sources it does the lookup
loader_line() {
  local kc=""; [[ -z "${SECRET_KEYCHAIN:-}" ]] || kc=" $(printf '%q' "$SECRET_KEYCHAIN")"
  # shellcheck disable=SC2016
  printf 'export %s="$(security find-generic-password -s %s -w%s 2>/dev/null)"' "$1" "$2" "$kc"
}

cmd_import() {
  local file="" rewrite=0 picks=() arg
  for arg in "$@"; do
    case "$arg" in
      --rewrite) rewrite=1 ;;
      -*) die "unknown option $arg" ;;
      *) if [[ -z "$file" ]]; then file="$arg"; else picks+=("$arg"); fi ;;
    esac
  done
  [[ -n "$file" ]] || die "missing <file>"
  [[ -f "$file" ]] || die "$file: no such file"

  # uncommented `export VAR=...` lines that are not Keychain lookups already
  local vars; vars=$(grep -E '^[[:space:]]*export[[:space:]]+[A-Za-z_][A-Za-z0-9_]*=' "$file" \
    | grep -v 'security find-generic-password' \
    | sed -E 's/^[[:space:]]*export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)=.*/\1/' | awk '!seen[$0]++')
  [[ -n "$vars" ]] || { warn "no plain 'export VAR=value' lines in $file"; return; }

  local moved=() var name value a pick found
  for var in $vars; do
    name=""
    if [[ ${#picks[@]} -gt 0 ]]; then
      for pick in "${picks[@]}"; do
        [[ "${pick%%=*}" == "$var" ]] || continue
        if [[ "$pick" == *=* ]]; then name="${pick#*=}"; else name=$(default_name "$var"); fi
      done
      [[ -n "$name" ]] || { printf '%s  skip %s%s\n' "$DIM" "$var" "$R" >&2; continue; }
    else
      if looks_secret "$var"; then
        read -r -p "Move ${B}$var${R} → Keychain item $(default_name "$var")? [Y/n/other-name] " a </dev/tty
        [[ "$a" == [nN] ]] && continue
      else
        read -r -p "Move ${B}$var${R} (looks like config) → $(default_name "$var")? [y/N/other-name] " a </dev/tty
        [[ -z "$a" || "$a" == [nN] ]] && continue
      fi
      if [[ -z "$a" || "$a" == [yY] ]]; then name=$(default_name "$var"); else name="$a"; fi
    fi
    # source the file in a clean zsh so quoting and $(...) resolve exactly as in your shell
    value=$(zsh -fc 'source "$1" >/dev/null 2>&1; printf %s "${(P)2}"' _ "$file" "$var")
    [[ -n "$value" ]] || { warn "$var is empty in $file — skipped"; continue; }
    store "$name" "$value"
    ok "$var → $name (${#value} chars)"
    ! hex_on_w "$value" \
      || warn "$var: holds a backslash or non-ASCII character; \`security -w\` returns such values as hex, so use \$(secret get $name) instead of the generated line"
    moved+=("$var=$name")
  done

  [[ ${#picks[@]} -eq 0 ]] || for pick in "${picks[@]}"; do
    found=0; for var in $vars; do [[ "${pick%%=*}" == "$var" ]] && found=1; done
    [[ $found -eq 1 ]] || warn "${pick%%=*}: no plain export line in $file"
  done
  [[ ${#moved[@]} -gt 0 ]] || { warn "nothing moved"; return; }

  if [[ $rewrite -eq 0 ]]; then
    printf '\n%sReplace these lines in %s:%s\n' "$B" "$file" "$R" >&2
    for pick in "${moved[@]}"; do loader_line "${pick%%=*}" "${pick#*=}"; echo; done
    printf '%s(or rerun with --rewrite)%s\n' "$DIM" "$R" >&2
    return
  fi

  # rewrite in place: same permissions, no plaintext backup left behind
  umask 077
  local tmp; tmp=$(mktemp "$(dirname "$file")/.secret-import.XXXXXX")
  chmod "$(stat -f '%Lp' "$file")" "$tmp"
  cp "$file" "$tmp"
  for pick in "${moved[@]}"; do
    var="${pick%%=*}"; name="${pick#*=}"
    awk -v var="$var" -v line="$(loader_line "$var" "$name")" '
      $0 ~ "^[[:space:]]*export[[:space:]]+" var "=" { print line; next } { print }' "$tmp" > "$tmp.n"
    cat "$tmp.n" > "$tmp"; rm -f "$tmp.n"
  done
  mv "$tmp" "$file"
  ok "rewrote $file — ${#moved[@]} line(s) now read from the Keychain"
}

case "${1:-}" in
  set)    shift; cmd_set "$@" ;;
  get)    shift; cmd_get "$@" ;;
  copy)   shift; cmd_copy "$@" ;;
  check)  shift; cmd_check "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  rm|delete) shift; cmd_rm "$@" ;;
  import) shift; cmd_import "$@" ;;
  -h|--help|help|"") usage ;;
  *) warn "unknown command $1"; usage 1 ;;
esac
